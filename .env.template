# Copy this file to .env and fill in the values. .env is not tracked by git; this
# template is, so it must never carry a real key.
#
# src/env_keys.py reads these into the environment. A variable already set in the
# shell wins over the file, so a rotated key needs no edit here.

# Hosted models: exp3 and the control analyses. Where a key is refused for the
# region it is billed to, put a key from another account here instead.
OPENROUTER_API_KEY=

# The judge in the control analyses.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Second source for the models OpenRouter has withdrawn.
DEEPINFRA_API_KEY=
FEATHERLESS_API_KEY=

# GPU rental for models no pay-per-token provider serves (src/vast.py).
VAST_API_KEY=

# Open-weight model downloads for exp4 and exp5.
HF_TOKEN=

# Optional, for gh CLI work in this repository.
GH_TOKEN=
